{
    "python-envs.pythonProjects": [
        {
            "path": ".",
            "envManager": "ms-python.python:system",
            "packageManager": "ms-python.python:pip"
        }
    ],
    "markdown.styles": [
        ".vscode/documentation.css"
    ],
    "workbench.editorAssociations": {
        "*.md": "vscode.markdown.preview.editor"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.venv": true,
        "**/venv": true,
        "**/*.egg-info": true
    }
}