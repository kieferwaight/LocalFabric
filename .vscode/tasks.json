{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Current File with Args",
      "type": "shell",
      "command": "uv run lfc run ${relativeFile} ${input:lfcArgs}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "lfcArgs",
      "type": "promptString",
      "description": "Args/options for lfc run (e.g. --url=https://example.com --foo=bar)",
      "default": ""
    }
  ]
}
