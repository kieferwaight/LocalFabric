# Default Docker build-context excludes for builds that use the repo root
# as context (e.g. 09_services/dev/jupyter/Dockerfile installs the project
# editably and needs the buckets, but not data or caches).

.git
.github
14_data
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.ipynb_checkpoints
**/node_modules
**/*.egg-info
.venv
venv
